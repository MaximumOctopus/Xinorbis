#include "Convert.h"
#include "LanguageHandler.h"
#include "ScanEngine.h"
#include "TabUiTemp.h"

extern LanguageHandler *GLanguageHandler;
extern ScanEngine *GScanEngine;


std::wstring TabUiTemp::Chart(TChart* chart, int DataSource, bool quantity)
{
	chart->SeriesList->Items[0]->Clear();
	chart->Legend->TextStyle = ltsPlain;

	if (GScanEngine->Data[DataSource].TotalSize != 0)
	{
		if (quantity)
		{
			chart->Title->Text->Strings[0] = GLanguageHandler->Text[kTempFilePTNF].c_str();

			if (GScanEngine->Data[DataSource].FileCount != 0)
			{
				chart->SeriesList->Items[0]->Add(100 - ((GScanEngine->Data[DataSource].ExtensionSpread[kCategoryTemp].Count) / GScanEngine->Data[DataSource].FileCount) * 100, GLanguageHandler->Text[kAllOtherFiles], TColor(0x444444));

				chart->SeriesList->Items[0]->Add(((GScanEngine->Data[DataSource].ExtensionSpread[kCategoryTemp].Size) / GScanEngine->Data[DataSource].FileCount) * 100, GLanguageHandler->Text[kTempFiles], TColor(0x00CCFF));
			}
		}
		else
		{
			chart->Title->Text->Strings[0] = GLanguageHandler->Text[kTempFilePTSF].c_str();

			chart->SeriesList->Items[0]->Add(100 - ((GScanEngine->Data[DataSource].ExtensionSpread[kCategoryTemp].Count) / GScanEngine->Data[DataSource].TotalSize) * 100, GLanguageHandler->Text[kAllOtherFiles], TColor(0x444444));
			chart->SeriesList->Items[0]->Add(((GScanEngine->Data[DataSource].ExtensionSpread[kCategoryTemp].Size) / GScanEngine->Data[DataSource].TotalSize) * 100, GLanguageHandler->Text[kTempFiles], TColor(0x00CCFF));
		}
	}

	if (GScanEngine->Data[DataSource].ExtensionSpread[kCategoryTemp].Count != 0)
	{
		return std::to_wstring(GScanEngine->Data[DataSource].ExtensionSpread[kCategoryTemp].Count) + L" " +
			   GLanguageHandler->Text[kFiles] +
			   L" (" + Convert::ConvertToUsefulUnit(GScanEngine[aDataIndex].ExtensionSpread[kCategoryTemp].Size) + L")";
	}
	else
	{
		return GLanguageHandler->Text[kNoTempFilesFound];
	}
}


void TabUiTemp::Table(TStringGrid* grid, int DataSource)
{
	//grid->ClearRows(1, grid.RowCount - 1);
	grid->RowCount = 2;

	if (GScanEngine->Data[DataSource].TemporaryFiles.size() == 0)
	{
		grid->Cells[kUsersTableName][1] = GLanguageHandler->Text[kNoneFound].c_str();
		return;
	}

	int count = 0;
	unsigned __int64 size = 0;
	int Row = 1;

	grid->BeginUpdate();

	grid->RowCount = GScanEngine->Data[DataSource].TemporaryFiles.size() + 1;

	for (TempFileObject *file : GScanEngine->Data[DataSource].TemporaryFiles)
	{
		grid->Cells[0][Row] = file->Name.c_str();
		grid->Cells[1][Row] = Convert::ConvertToUsefulUnit(file->Size).c_str();

		Row++;
	}

//	DoTableSort(oTable, oTable.SortSettings.Column, UsersSortColumns[oTable.SortSettings.Column]);

	grid->EndUpdate();
}